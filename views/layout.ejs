<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Электронный учебник по PHP' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <a href="/" class="logo">PHP Course</a>
      <div class="nav-links">
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="welcome">Привет, <%= user.username %>!</span>
          <% if (user.role === 'student') { %>
            <a href="/dashboard">Мой кабинет</a>
            <a href="/final-test">Итоговый тест</a>
          <% } else if (user.role === 'teacher') { %>
            <a href="/teacher/dashboard">Панель учителя</a>
            <a href="/teacher/questions">Управление вопросами</a>
          <% } %>
          <a href="/logout" class="btn-logout">Выход</a>
        <% } else { %>
          <a href="/login">Вход</a>
          <a href="/register" class="btn-register">Регистрация</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="container main-content">
    <%- body %>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2024 Электронный учебник по PHP. Дипломная работа.</p>
    </div>
  </footer>
</body>
</html>
