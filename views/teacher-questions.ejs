<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Управление вопросами - Электронный учебник по PHP</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <a href="/" class="logo">PHP Course</a>
      <div class="nav-links">
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="welcome">Привет, <%= user.username %>!</span>
          <% if (user.role === 'student') { %>
            <a href="/dashboard">Мой кабинет</a>
            <a href="/final-test">Итоговый тест</a>
          <% } else if (user.role === 'teacher') { %>
            <a href="/teacher/dashboard">Панель учителя</a>
            <a href="/teacher/questions">Управление вопросами</a>
          <% } %>
          <a href="/logout" class="btn-logout">Выход</a>
        <% } else { %>
          <a href="/login">Вход</a>
          <a href="/register" class="btn-register">Регистрация</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="container main-content">
    <h1>📝 Управление вопросами тестов</h1>

    <div class="teacher-controls">
      <a href="/teacher/dashboard" class="btn btn-secondary">← Назад к панели учителя</a>
    </div>

    <!-- Форма добавления вопроса -->
    <div class="add-question-section">
      <h2>Добавить новый вопрос</h2>
      <form action="/teacher/questions/add" method="POST" class="add-question-form" id="addQuestionForm">
        <div class="form-group">
          <label for="module_id">Модуль:</label>
          <select id="module_id" name="module_id">
            <option value="">-- Итоговый тест --</option>
            <% modules.forEach(module => { %>
              <option value="<%= module.id %>"><%= module.title %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="question_text">Текст вопроса:</label>
          <textarea id="question_text" name="question_text" rows="3" required placeholder="Введите текст вопроса"></textarea>
        </div>

        <div class="form-group">
          <label for="question_type">Тип вопроса:</label>
          <select id="question_type" name="question_type" required onchange="toggleAnswerFields()">
            <option value="single">Один правильный ответ</option>
            <option value="multiple">Несколько правильных ответов</option>
          </select>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="is_final_test" id="is_final_test">
            Вопрос для итогового теста
          </label>
        </div>

        <div id="answers-container">
          <h3>Варианты ответов</h3>
          <div class="answer-row">
            <input type="text" name="answers[]" placeholder="Вариант ответа 1" required>
            <label><input type="radio" name="is_correct_0" value="on" checked> Правильный</label>
          </div>
          <div class="answer-row">
            <input type="text" name="answers[]" placeholder="Вариант ответа 2" required>
            <label><input type="radio" name="is_correct_1" value="on"> Правильный</label>
          </div>
          <div class="answer-row">
            <input type="text" name="answers[]" placeholder="Вариант ответа 3" required>
            <label><input type="radio" name="is_correct_2" value="on"> Правильный</label>
          </div>
          <div class="answer-row">
            <input type="text" name="answers[]" placeholder="Вариант ответа 4" required>
            <label><input type="radio" name="is_correct_3" value="on"> Правильный</label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary">Добавить вопрос</button>
      </form>
    </div>

    <!-- Список существующих вопросов -->
    <div class="questions-list-section">
      <h2>Существующие вопросы (<%= questions.length %>)</h2>
      
      <% if (questions.length === 0) { %>
        <div class="alert alert-info">
          <p>Пока нет добавленных вопросов.</p>
        </div>
      <% } else { %>
        <div class="questions-table-container">
          <table class="questions-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Модуль/Тест</th>
                <th>Вопрос</th>
                <th>Тип</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody>
              <% questions.forEach(question => { %>
                <tr>
                  <td><%= question.id %></td>
                  <td>
                    <% if (question.is_final_test) { %>
                      <span class="badge badge-success">Итоговый тест</span>
                    <% } else { %>
                      <%= question.module_title || 'Без модуля' %>
                    <% } %>
                  </td>
                  <td class="question-text-cell"><%= question.question_text %></td>
                  <td>
                    <span class="badge <%= question.question_type === 'single' ? 'badge-info' : 'badge-warning' %>">
                      <%= question.question_type === 'single' ? 'Один ответ' : 'Несколько' %>
                    </span>
                  </td>
                  <td>
                    <form action="/teacher/questions/delete/<%= question.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Вы уверены, что хотите удалить этот вопрос?');">
                      <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2024 Электронный учебник по PHP. Дипломная работа.</p>
    </div>
  </footer>

  <script>
    function toggleAnswerFields() {
      const type = document.getElementById('question_type').value;
      const radios = document.querySelectorAll('#answers-container input[type="radio"]');
      
      radios.forEach(radio => {
        if (type === 'multiple') {
          radio.type = 'checkbox';
        } else {
          radio.type = 'radio';
          // Оставляем только один выбранным
          const name = radio.name;
          const radiosWithSameName = document.querySelectorAll(`input[name="${name}"]`);
          let firstChecked = false;
          radiosWithSameName.forEach(r => {
            if (!firstChecked && r.checked) {
              firstChecked = true;
            } else {
              r.checked = false;
            }
          });
        }
      });
    }

    // Инициализация при загрузке
    document.addEventListener('DOMContentLoaded', function() {
      toggleAnswerFields();
    });
  </script>
</body>
</html>
